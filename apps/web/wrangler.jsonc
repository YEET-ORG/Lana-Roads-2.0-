{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lanaroads",
  "account_id": "30a113a636e7792fb845964f984173e5",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "lanaroads.mystic.cat",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/magic-router", "/magic-router/*"],
  },
}
