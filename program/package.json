    "test:crossy": "ts-mocha -p ./tsconfig.json -t 60000 tests/crossy-world.ts",
    "test:nft": "ts-mocha -p ./tsconfig.json -t 120000 tests/crossy-nft.ts",
    "test:lifecycle": "tsx tests/run-lifecycle.ts",
    "test:crossy-devnet": "PROVIDER_ENDPOINT=https://api.devnet.solana.com WS_ENDPOINT=wss://api.devnet.solana.com FUND_FROM_WALLET=1 ts-mocha -p ./tsconfig.json -t 240000 tests/crossy-nft.ts",
